# Database settings
DATABASE_URL=api-key://neondb_owner:
JWT_SECRET=ExampleSecret
# Server settings
NODE_ENV=development
PORT=5000

# JWT settings
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Bcrypt settings
BCRYPT_SALT_ROUNDS=10

# Rate limiting (see backend/middleware/rateLimit.js)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MANAGEMENT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_MOCK_WINDOW_MS=60000
RATE_LIMIT_MOCK_MAX=120

# Ping settings for render, to avoid sleeping
PING_INTERVAL=number_of_seconds
PING_URL=http://localhost:3000